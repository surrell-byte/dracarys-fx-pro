# Copy this file to frontend/.env and fill in your own key.
# Get a free key at https://twelvedata.com (Basic/free plan: 800 API
# calls/day, 8/minute). Never commit the real .env file - add it to
# .gitignore if you haven't already.
VITE_TWELVEDATA_API_KEY=your_key_here

# Report server (frontend/scripts/scheduler/reportServer.js) - protects the
# daily reports page with HTTP Basic Auth. Pick your own values.
REPORTS_USER=
REPORTS_PASSWORD=
REPORTS_PORT=8787
# Leave blank when Vercel uses the same-origin proxy below.
REPORTS_CORS_ORIGIN=

# Set these only in Vercel Project Settings → Environment Variables. They
# are used by api/live-reports.js and are never bundled into the dashboard.
# REPORTS_API_URL=https://reports.example.com/api/latest
# REPORTS_API_USER=
# REPORTS_API_PASSWORD=
